# ─────────────────────────────────────────────────────────────────────────────
# .env.production — Production environment TEMPLATE
# File ini berisi PLACEHOLDER — isi nilai asli di Vercel Dashboard
# Environment Variables > Add New > pilih Environment: Production
#
# JANGAN isi nilai asli di sini dan commit ke git
# ─────────────────────────────────────────────────────────────────────────────

# ── DATABASE ──────────────────────────────────────────────────────────────────
# Gunakan connection pooling untuk production (Neon/Supabase sudah include)
# Format Neon: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Format Supabase: postgresql://postgres:PASSWORD@HOST:5432/postgres
DATABASE_URL="postgresql://neondb_owner:npg_dSQnNLbe3h1E@ep-flat-pond-aoo2r07y-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ── NEXTAUTH ──────────────────────────────────────────────────────────────────
# Generate baru untuk production: openssl rand -base64 32
# JANGAN pakai secret yang sama dengan development
AUTH_SECRET="SET_IN_VERCEL_DASHBOARD"

# URL production aplikasi (tanpa trailing slash)
AUTH_URL="https://your-app.vercel.app"

# ── CLOUDINARY ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="SET_IN_VERCEL_DASHBOARD"
CLOUDINARY_API_KEY="SET_IN_VERCEL_DASHBOARD"
CLOUDINARY_API_SECRET="SET_IN_VERCEL_DASHBOARD"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="SET_IN_VERCEL_DASHBOARD"

# ── APP ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
NODE_ENV="production"
