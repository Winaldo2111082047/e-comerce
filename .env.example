# ─────────────────────────────────────────────────────────────────────────────
# TokoKita — Environment Variables Template
#
# CARA PAKAI:
#   Development : cp .env.example .env.local
#   Production  : Set di Vercel Dashboard → Settings → Environment Variables
#
# ⚠️  JANGAN PERNAH commit file .env, .env.local, .env.production ke git!
# ─────────────────────────────────────────────────────────────────────────────

# ── DATABASE ──────────────────────────────────────────────────────────────────
# Development  : postgresql://postgres:password@localhost:5432/tokokita
# Production   : Gunakan POOLED connection string dari Neon (ada -pooler di hostname)
#                postgresql://USER:PASS@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/tokokita?sslmode=require
#
# Cara dapat: neon.tech → Project → Connection Details → Connection pooling ON → Copy
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# ── NEXTAUTH ──────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
# WAJIB minimal 32 karakter — gunakan nilai BERBEDA antara dev dan production
AUTH_SECRET="GENERATE_WITH_openssl_rand_-base64_32"

# URL lengkap aplikasi (tanpa trailing slash)
# Development : http://localhost:3000
# Production  : https://nama-app.vercel.app
AUTH_URL="http://localhost:3000"

# ── CLOUDINARY ────────────────────────────────────────────────────────────────
# Cara dapat: cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Public key — aman di-expose ke browser (prefix NEXT_PUBLIC_)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"

# ── APP ───────────────────────────────────────────────────────────────────────
# URL publik aplikasi — dipakai untuk SEO, OG images, sitemap
# Development : http://localhost:3000
# Production  : https://nama-app.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── NODE ENV ──────────────────────────────────────────────────────────────────
# Vercel otomatis set ini ke "production" — tidak perlu di-set manual
# NODE_ENV="development"

# ── ANALYTICS (OPSIONAL) ──────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID
# Cara dapat: analytics.google.com → Admin → Data Streams → Web → Measurement ID
# Format: G-XXXXXXXXXX
# Kosongkan jika tidak pakai Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
